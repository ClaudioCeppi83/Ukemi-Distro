# Ukemi Distro Kernel Configuration Baseline
# Required by kernel-optimizer skill

# Mandatory for Low-Latency Desktop
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# High Performance & Modern HW
CONFIG_O3=y
CONFIG_MARCH_NATIVE=y

# Disable Legacy/Unneeded (Examples)
# CONFIG_FLOPPY is not set
# CONFIG_PARPORT is not set
